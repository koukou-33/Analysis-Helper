# Copy to .env and fill in locally. No actual model or credential is preselected.
# PROVIDER supports openai_compatible (key required) or local_openai (key optional).
# BASE_URL must include the API prefix, e.g. your service's /v1 endpoint.
# No model name is guessed; set MODEL explicitly. Restart Streamlit after editing.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_SUPPORTS_VISION=false

EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# Optional separate vision service. Leave blank to use text-only fallback,
# or a configured main LLM that supports image inputs.
VISION_PROVIDER=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_RETRIES=2
VISION_SUPPORTS_VISION=false

# Bounded coverage backfill (field batch <= 10)
SRS_BACKFILL_MAX_ROUNDS=2
SRS_BACKFILL_FIELD_BATCH=10
SRS_ANALYSIS_BUDGET_SECONDS=120

# Optional response recovery. Confirm parameter support with your actual endpoint first.
# Empty parameter and zero tokens preserve provider defaults; no automatic recovery.
# Allowed parameter: max_tokens or max_completion_tokens (never sent together).
LLM_OUTPUT_TOKEN_PARAMETER=
LLM_PLAN_OUTPUT_TOKENS=0
LLM_EXPLAIN_OUTPUT_TOKENS=0
LLM_RECOVERY_OUTPUT_TOKENS=0
LLM_STRUCTURED_RETRIES=0
# HTTP attempts and structured recovery share this per-chat-call scheduling budget.
LLM_CALL_BUDGET_SECONDS=180
# EMBEDDING_ and VISION_ support the same configuration prefix where applicable.

# Verified optional profile for the direct BigModel glm-5.3-flash endpoint only.
# This model cannot disable thinking. Valid effort: low / high / max.
# Leave both blank for other providers. See docs/RUNBOOK.md.
LLM_CAPABILITY_PROFILE=
LLM_REASONING_EFFORT=

# Continuous verification: cumulative within one action; retries do not reset budgets.
# Valid ranges: queries 1..12, verification planner calls 1..6, plan/verification/explanation invocations 1..24.
SRS_VERIFY_MAX_QUERIES=12
SRS_VERIFY_MAX_PLANNER_CALLS=6
SRS_ANALYSIS_MAX_MODEL_CALLS=12
