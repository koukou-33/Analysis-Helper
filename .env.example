# Copy to .env and fill in locally. No actual model or credential is preselected.
# PROVIDER supports openai_compatible (key required) or local_openai (key optional).
# BASE_URL must include the API prefix, e.g. your service's /v1 endpoint.
# No model name is guessed; set MODEL explicitly. Restart Streamlit after editing.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_SUPPORTS_VISION=false

EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# Optional separate vision service. Leave blank to use text-only fallback,
# or a configured main LLM that supports image inputs.
VISION_PROVIDER=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_RETRIES=2
VISION_SUPPORTS_VISION=false
